      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"nopCommerce\"}",
          "tableType": "traces",
          "refId": "A",
          "filters": [],
          "limit": 20,
          "streaming": false
        }
      ],
      "title": "Checkout Flow Traces",
      "type": "table"
    }
  ]
